diff --git a/sources/VTableSwapHook.cpp b/sources/VTableSwapHook.cpp
index a8f5df3..4e804d8 100644
--- a/sources/VTableSwapHook.cpp
+++ b/sources/VTableSwapHook.cpp
@@ -17,6 +17,12 @@ PLH::VTableSwapHook::VTableSwapHook(const uint64_t Class, const VFuncMap& redire
 	, m_redirectMap(redirectMap)
 	, m_userOrigMap(userOrigMap)
 {}
+// Platform prefix sizes (in pointer-width units)
+#if defined(_MSC_VER)
+static constexpr size_t VTABLE_PREFIX_ENTRIES = 1;  // RTTI Complete Object Locator
+#else
+static constexpr size_t VTABLE_PREFIX_ENTRIES = 2;  // offset-to-top + type_info*
+#endif
 
 bool PLH::VTableSwapHook::hook() {
 	assert(m_userOrigMap != nullptr);
@@ -36,10 +42,16 @@ bool PLH::VTableSwapHook::hook() {
 		return false;
 	}
 
-	m_newVtable.reset(new uintptr_t[m_vFuncCount]);
+	// +PREFIX_ENTRIES to include RTTI data before the function pointers
+	const size_t totalEntries = m_vFuncCount + VTABLE_PREFIX_ENTRIES;
+	m_newVtable.reset(new uintptr_t[totalEntries]);
 
-	// deep copy orig vtable into new
-	memcpy(m_newVtable.get(), m_origVtable, sizeof(uintptr_t) * m_vFuncCount);
+	// Copy including the RTTI prefix
+	uintptr_t* srcBase = m_origVtable - VTABLE_PREFIX_ENTRIES;
+	memcpy(m_newVtable.get(), srcBase, sizeof(uintptr_t) * totalEntries);
+
+	// The vtable pointer the class stores must point PAST the prefix
+	uintptr_t* newVtableStart = m_newVtable.get() + VTABLE_PREFIX_ENTRIES;
 
 	for (const auto& p : m_redirectMap) {
 		assert(p.first < m_vFuncCount);
@@ -51,11 +63,11 @@ bool PLH::VTableSwapHook::hook() {
 		}
 
 		// redirect ptr at VTable[i]
-		(*m_userOrigMap)[p.first] = (uint64_t)m_newVtable[p.first];
-		m_newVtable[p.first] = (uintptr_t)p.second;
+		(*m_userOrigMap)[p.first] = (uint64_t)newVtableStart[p.first];
+		newVtableStart[p.first] = (uintptr_t)p.second;
 	}
 
-	*(uint64_t**)m_class = (uint64_t*)m_newVtable.get();
+	*(uint64_t**)m_class = (uint64_t*)newVtableStart;
 	m_hooked = true;
 	Log::log("vtable hooked", ErrorLevel::INFO);
 	return true;
diff --git a/UnitTests/linux/TestMemProtector.cpp b/UnitTests/linux/TestMemProtector.cpp
index 739ecfb..b7d54e4 100644
--- a/UnitTests/linux/TestMemProtector.cpp
+++ b/UnitTests/linux/TestMemProtector.cpp
@@ -1,6 +1,7 @@
 #include "Catch.hpp"
 #include "polyhook2/MemProtector.hpp"
 #include "polyhook2/Tests/StackCanary.hpp"
+#include "polyhook2/Misc.hpp"
 
 #include "polyhook2/PolyHookOsIncludes.hpp"
 
@@ -66,4 +67,48 @@ TEST_CASE("Test setting page protections", "[MemProtector]") {
 		REQUIRE(prot2.originalProt() == (PLH::ProtFlag::X | PLH::ProtFlag::W));
 	}
 	munmap(page, 4*1024);
-}
\ No newline at end of file
+}
+
+TEST_CASE("Unaligned protection covers only the requested pages", "[MemProtector]") {
+	const size_t pageSize = PLH::getPageSize();
+	char* pages = (char*)mmap(nullptr, 3 * pageSize, PROT_READ | PROT_WRITE,
+		MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	REQUIRE(pages != MAP_FAILED);
+	PLH::MemAccessor accessor;
+	auto currentProtection = [&](char* address) {
+		bool status = false;
+		auto protection = accessor.mem_protect((uint64_t)address, 0, PLH::ProtFlag::NONE, status);
+		REQUIRE(status);
+		return protection;
+	};
+
+	size_t offset = pageSize - 16;
+	size_t length = 32;
+	bool secondExecutable = true;
+	SECTION("crosses the first page boundary") {}
+	SECTION("ends exactly at the first page boundary") {
+		length = 16;
+		secondExecutable = false;
+	}
+	SECTION("starts on a page boundary") {
+		offset = 0;
+		length = pageSize;
+		secondExecutable = false;
+	}
+	SECTION("zero length at an unaligned address changes nothing") {
+		length = 0;
+		secondExecutable = false;
+	}
+	{
+		PLH::MemoryProtector protection((uint64_t)(pages + offset), length,
+			PLH::ProtFlag::R | PLH::ProtFlag::W | PLH::ProtFlag::X, accessor);
+		REQUIRE(protection.isGood());
+		REQUIRE(protection.originalProt() == (PLH::ProtFlag::R | PLH::ProtFlag::W));
+		REQUIRE((currentProtection(pages) & PLH::ProtFlag::X) == (length != 0));
+		REQUIRE((currentProtection(pages + pageSize) & PLH::ProtFlag::X) == secondExecutable);
+		REQUIRE(currentProtection(pages + 2 * pageSize) == (PLH::ProtFlag::R | PLH::ProtFlag::W));
+	}
+	for (size_t page = 0; page < 3; ++page)
+		REQUIRE(currentProtection(pages + page * pageSize) == (PLH::ProtFlag::R | PLH::ProtFlag::W));
+	REQUIRE(munmap(pages, 3 * pageSize) == 0);
+}
